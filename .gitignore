# Claude Code: shared project config (.claude/settings.json, .claude/launch.json)
# IS versioned; per-machine state is not. These were previously covered only by
# .git/info/exclude and a global gitignore — i.e. only on one machine, so a
# fresh clone could commit an entire worktree checkout.
.claude/worktrees/
.claude/settings.local.json

# Supabase CLI local branch marker (machine state)
supabase/.branches/
