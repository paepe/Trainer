{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    { "source": "/studio",    "destination": "/studio.html" },
    { "source": "/studio/(.*)", "destination": "/studio.html" },
    { "source": "/invite/(.*)", "destination": "/index.html" },
    { "source": "/legal/(.*)", "destination": "/index.html" }
  ]
}
